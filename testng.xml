<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OBEM Regression Suite" parallel="classes" thread-count="4" data-provider-thread-count="4">
    <listeners>
        <listener class-name="com.obem.listeners.ExtentReportListener"/>
    </listeners>

    <test name="OBEM UI Regression">
        <classes>
            <class name="com.obem.tests.LoginTest"/>
            <class name="com.obem.tests.DashboardTest"/>
            <class name="com.obem.tests.BuildingTest"/>
            <class name="com.obem.tests.EnergyTest"/>
            <class name="com.obem.tests.AlarmFddTest"/>
        </classes>
    </test>
</suite>
